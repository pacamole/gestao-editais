{
  "name": "gestao-editais",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --ignore ./src/client src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:reset": "tsx --disable-warning=ExperimentalWarning src/server/db/reset.ts",
    "email:teste": "tsx --disable-warning=ExperimentalWarning src/server/notificacao/cli-teste.ts",
    "db:exportar": "tsx --disable-warning=ExperimentalWarning src/server/base/cli-exportar.ts",
    "db:importar": "tsx --disable-warning=ExperimentalWarning src/server/base/cli-importar.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
