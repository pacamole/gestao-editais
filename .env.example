PORT=3000
DATABASE_PATH=data/editais.db
# Endereço público do sistema, usado nos links dos e-mails
APP_URL=http://localhost:3000

# Chat local sobre o edital (Gemma 2 9B; instale com `ollama pull gemma2:latest`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:latest
OLLAMA_TIMEOUT_MS=600000
OLLAMA_NUM_CTX=8192

# Usuário Gestor criado pelo `npm run db:reset`
GESTOR_NOME=Gestor
GESTOR_EMAIL=gestor@i9mais.com.br
GESTOR_SENHA=troque-esta-senha

# E-mail (SMTP). Sem SMTP_HOST, os e-mails são apenas impressos no terminal.
# Gmail: ative a verificação em 2 etapas e gere uma "senha de app" em
# https://myaccount.google.com/apppasswords — use-a em SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Editais I9+ <seu-email@gmail.com>
